# Required
# DATA_DIR stores both Redis persistence and encrypted uploaded files.
DATA_DIR=./data

# Optional
APP_PORT=8080

# Backend upstream (host:port) nginx proxies /api/ to.
# Override when your Docker networking needs a different host, e.g. host.docker.internal:8080.
BACKEND_UPSTREAM=backend:8080

# Rate limits are per visitor IP. Behind your reverse proxy, nginx reads the
# visitor IP from REAL_IP_HEADER when the request comes from TRUSTED_PROXIES
# (default: the container's own Docker network, which covers a proxy container
# on the same network and a proxy on the host; "none" trusts nobody). Set it
# for a proxy on another machine. Never trust whole private ranges: users on
# an internal network could then fake their IP.
# TRUSTED_PROXIES=10.0.4.20
# REAL_IP_HEADER=X-Forwarded-For
# RATE_LIMIT=on
# RATE_LIMIT_WRITE=45r/m
# RATE_LIMIT_UPLOAD=120r/m
# RATE_LIMIT_READ=60r/m
