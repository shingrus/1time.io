---
import {isSelfHosted} from '../lib/siteConfig.js';
import {langNames, langs, navText, type Alternates, type Lang} from '../lib/i18n.js';

const {lang = 'en', alternates} = Astro.props as {lang?: Lang; alternates?: Alternates};
const selfHosted = isSelfHosted();
const labels = lang === 'en' ? undefined : navText[lang];
const englishLinkLang = labels ? 'en' : undefined;
---
{selfHosted ? (
<footer class="app-footer">
    <p class="app-footer-text">&copy; 2026 <a href="https://1time.io" rel="noreferrer">1time.io</a></p>
</footer>
) : (
<footer class="app-footer">
    {!labels && (
    <nav class="app-footer-tools">
        <a href="/secure-file-sharing/">One-Time File Sharing</a>
        <a href="/password-generator/">Password Generator</a>
        <a href="/my-secrets/">My Secrets</a>
        <a href="/developers/">Developers</a>
        <a href="/self-hosted/">Self-Hosted</a>
        <a href="/blog/">Blog</a>
    </nav>
    )}
    <nav class="app-footer-tools">
        <a href="/about/" hreflang={englishLinkLang}>{labels?.about ?? 'About'}</a>
        <a href="/privacy/" hreflang={englishLinkLang}>{labels?.privacy ?? 'Privacy'}</a>
        <a href="mailto:info@1time.io">{labels?.contact ?? 'Contact'}</a>
        <a href="https://github.com/shingrus/1time" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
    {alternates && (
    <p class="app-footer-text">
        {langs.map((code, i) => (
            <Fragment>{i > 0 && ' · '}{code === lang ? langNames[code] : <a href={alternates[code]} hreflang={code} lang={code}>{langNames[code]}</a>}</Fragment>
        ))}
    </p>
    )}
</footer>
)}
