<template id="link-ready-template">
    <section class="link-display" aria-labelledby="link-ready-title">
        <header class="link-ready-header">
            <span class="link-ready-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <polyline points="8.5 12 11 14.5 15.75 9.75" />
                </svg>
            </span>
            <div class="link-ready-copy">
                <h2 class="link-display-label" id="link-ready-title" data-link-title>Your one-time secret link is ready</h2>
                <p class="link-ready-meta">
                    <span data-link-expiry>Expires in 1 day</span>
                    <span aria-hidden="true"> · </span>
                    <span data-link-uses>1 view</span>
                </p>
            </div>
        </header>

        <div class="link-copy-control">
            <input
                class="link-display-input"
                data-link-input
                aria-label="Secret one-time link"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                type="text"
                readonly
            />
            <button class="btn btn-success btn-lg link-copy-button" type="button" data-copy>
                <span>Copy</span>
                <span class="link-copy-status" data-copy-status aria-live="polite" hidden></span>
            </button>
        </div>

        <nav class="link-secondary-actions" aria-label="Link actions">
            <button class="link-inline-action" type="button" data-toggle-qr aria-expanded="false">
                <span data-qr-label>Show QR code</span>
            </button>
            <button class="link-inline-action link-inline-action-accent" type="button" data-reset>Send another secret</button>
        </nav>

        <section class="qr-panel" data-qr-panel hidden aria-live="polite">
            <div class="qr-panel-code"><div data-qr-slot aria-label="Secret link QR code"></div></div>
        </section>

        <div class="link-warning" role="note">
            <p data-link-warning></p>
        </div>

        <div class="link-footer-meta" data-footer-meta>
            <span data-reference-wrap hidden>Reference <strong data-reference-name></strong></span>
            <span data-footer-separator aria-hidden="true" hidden>·</span>
            <a class="link-extension" href="/my-secrets/">Check if it's been read</a>
        </div>
    </section>
</template>
