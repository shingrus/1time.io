---
import LinkReadyTemplate from './LinkReadyTemplate.astro';
import {Constants, SHARE_DURATION_OPTIONS} from '../lib/util.js';
---
<form id="new-message-form" autocomplete="off">
    <div class="form-field">
        <label class="form-label" for="secretMessage">Your secret message, end-to-end encrypted.</label>
        <textarea
            autofocus
            class="form-textarea"
            id="secretMessage"
            autocomplete="off"
            autocapitalize="none"
            placeholder="Paste a password, API key, private note, or any sensitive text..."
            rows="5"
            spellcheck="false"
        ></textarea>
    </div>

    <div class="form-actions share-primary-actions">
        <div class="options-chips" data-chips>
            <button type="button" class="option-chip" data-chip="duration" aria-expanded="false" aria-controls="share-options">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>1 day</span>
            </button>
            <button type="button" class="option-chip" data-chip="views" aria-expanded="false" aria-controls="share-options">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
                <span>1 view</span>
            </button>
            <button type="button" class="option-chip" data-chip="secretKey" aria-expanded="false" aria-controls="share-options">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <span>set passphrase</span>
            </button>
        </div>
        <button class="btn btn-primary btn-lg" disabled type="submit">
            <span class="btn-label">Create one-time link</span>
            <kbd class="btn-kbd" data-shortcut-hint aria-hidden="true" hidden></kbd>
        </button>
    </div>

    <div class="options-grid" id="share-options" data-options-panel hidden>
        <div class="form-field options-grid-full" style="margin-bottom:0">
            <label class="form-label" for="secretKey">Additional passphrase</label>
            <input
                class="form-input"
                id="secretKey"
                autocomplete="off"
                autocapitalize="none"
                placeholder="Optional extra security"
                spellcheck="false"
                type="text"
            />
            <p class="form-help">Recipient will need this to decrypt</p>
        </div>
        <div class="form-field" style="margin-bottom:0">
            <label class="form-label" for="duration">Expire after</label>
            <select class="form-select" id="duration">
                {SHARE_DURATION_OPTIONS.map(({value, label}) => (
                    <option value={value} selected={value === Constants.defaultDurationSeconds}>{label}</option>
                ))}
            </select>
            <p class="form-help">Link expires even if unread</p>
        </div>
        <div class="form-field" style="margin-bottom:0">
            <label class="form-label" for="views">Views allowed</label>
            <select class="form-select" id="views">
                <option value="1" selected>1 — burn after reading</option>
                <option value="3">3 views</option>
                <option value="5">5 views</option>
                <option value="10">10 views</option>
            </select>
            <p class="form-help">More than 1 view means the link is not burn-on-read</p>
        </div>
    </div>

    <p class="form-help form-help-error" data-message-error role="alert" hidden></p>
</form>

<LinkReadyTemplate />

<script>
    import '../islands/new-message.ts';
</script>
