---
import EncryptionNote from './EncryptionNote.astro';
import LinkReadyTemplate from './LinkReadyTemplate.astro';
import ShareOptions from './ShareOptions.astro';
import {messageFormData, ui, type Lang} from '../lib/i18n.js';

const {lang = 'en'} = Astro.props as {lang?: Lang};
const t = ui[lang];
---
<form id="new-message-form" autocomplete="off" {...messageFormData(lang)}>
    <div class="share-card">
        <p class="share-title">{t.shareTitle}</p>

        <ShareOptions kind="secret" lang={lang}>
            <textarea
                slot="primary"
                class="form-textarea secret-textarea"
                id="secretMessage"
                aria-label={t.secretLabel}
                autofocus
                autocomplete="off"
                autocapitalize="none"
                placeholder={t.secretPlaceholder}
                rows="5"
                spellcheck="false"
            ></textarea>
            <button slot="submit" class="btn btn-primary btn-lg" disabled type="submit">
                <span><span class="btn-label">{t.createLink}</span><kbd class="btn-kbd" data-shortcut-hint aria-hidden="true" hidden></kbd></span>
            </button>
        </ShareOptions>

        <p class="form-help form-help-error share-form-error" data-message-error role="alert" hidden></p>
        <EncryptionNote lang={lang} />
    </div>
</form>

<LinkReadyTemplate lang={lang} />

<script>
    import '../islands/new-message.ts';
</script>
