---
import EncryptionNote from './EncryptionNote.astro';
import LinkReadyTemplate from './LinkReadyTemplate.astro';
import ShareOptions from './ShareOptions.astro';
---
<form id="new-message-form" autocomplete="off">
    <div class="share-card">
        <p class="share-title">Send a one-time secret</p>

        <ShareOptions kind="secret">
            <textarea
                slot="primary"
                class="form-textarea secret-textarea"
                id="secretMessage"
                aria-label="Secret message"
                autofocus
                autocomplete="off"
                autocapitalize="none"
                placeholder="Paste a password, API key, or private note"
                rows="5"
                spellcheck="false"
            ></textarea>
            <!-- Filled in by the lazily loaded strength meter; ships as an empty div. -->
            <div slot="primary" data-strength hidden></div>
            <button slot="submit" class="btn btn-primary btn-lg" disabled type="submit">
                <span class="btn-label">Create one-time link</span>
                <kbd class="btn-kbd" data-shortcut-hint aria-hidden="true" hidden></kbd>
            </button>
        </ShareOptions>

        <p class="form-help form-help-error share-form-error" data-message-error role="alert" hidden></p>
        <EncryptionNote />
    </div>
</form>

<LinkReadyTemplate />

<script>
    import '../islands/new-message.ts';
</script>
