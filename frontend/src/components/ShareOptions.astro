---
import {Constants, SHARE_DURATION_OPTIONS} from '../lib/util.js';

interface Props {
    kind?: 'secret' | 'file';
    panelId: string;
}

const {kind = 'secret', panelId} = Astro.props;
const isFile = kind === 'file';
const usageNoun = isFile ? 'download' : 'view';
const usageOptions = [1, 2, 3, 5, 10];
---
<div class="form-actions share-primary-actions">
    <div class="options-chips" data-chips>
        <button type="button" class="option-chip" data-chip="duration" aria-expanded="false" aria-controls={panelId}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span data-chip-label>1 day</span>
        </button>
        <button type="button" class="option-chip" data-chip="views" aria-expanded="false" aria-controls={panelId}>
            {isFile ? (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3v12"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <path d="M5 21h14"/>
                </svg>
            ) : (
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            )}
            <span data-chip-label>1 {usageNoun}</span>
        </button>
        <button type="button" class="option-chip" data-chip="secretKey" aria-expanded="false" aria-controls={panelId}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span data-chip-label>set passphrase</span>
        </button>
    </div>
    <slot name="submit" />
</div>

<div
    class="options-grid"
    id={panelId}
    data-options-panel
    hidden
>
    <div class="form-field options-grid-full" style="margin-bottom:0">
        <label class="form-label" for="secretKey">Additional passphrase</label>
        <input
            class="form-input"
            id="secretKey"
            autocomplete="off"
            autocapitalize="none"
            placeholder="Optional extra security"
            spellcheck="false"
            type="text"
        />
        <p class="form-help">Recipient will need this to decrypt</p>
    </div>
    <div class="form-field" style="margin-bottom:0">
        <label class="form-label" for="duration">Expire after</label>
        <select class="form-select" id="duration">
            {SHARE_DURATION_OPTIONS.map(({value, label}) => (
                <option value={value} selected={value === Constants.defaultDurationSeconds}>{label}</option>
            ))}
        </select>
        <p class="form-help">Link expires even if unread</p>
    </div>
    <div class="form-field" style="margin-bottom:0">
        <label class="form-label" for="views">{isFile ? 'Downloads' : 'Views'} allowed</label>
        <select class="form-select" id="views">
            {usageOptions.map((count) => (
                <option value={count} selected={count === 1}>
                    {count === 1
                        ? (isFile ? '1 — one-time download link' : '1 — burn after reading')
                        : `${count} ${usageNoun}s`}
                </option>
            ))}
        </select>
        <p class="form-help">
            {isFile
                ? 'The encrypted file is destroyed after the last download'
                : 'More than 1 view means the link is not burn-on-read'}
        </p>
    </div>
</div>
