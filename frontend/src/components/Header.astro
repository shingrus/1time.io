---
import {isSelfHosted} from '../lib/siteConfig.js';
import {navText, type Alternates, type Lang} from '../lib/i18n.js';

const {lang = 'en', alternates} = Astro.props as {lang?: Lang; alternates?: Alternates};
const selfHosted = isSelfHosted();
---
<header class="app-header">
    <a href={lang === 'en' ? '/' : `/${lang}/`} class="app-logo">
        <svg width="28" height="28" viewBox="0 0 64 64">
            <rect width="64" height="64" rx="16" fill="#1C1917"/>
            <path d="M32 8.5C34 18 46.5 24 46.5 37.5A14.5 14.5 0 0 1 17.5 37.5C17.5 30 21.5 26 25 22C26 27 28 29.5 30 29.5C30 22 30 15 32 8.5Z" fill="#FFB020"/>
            <path d="M31.4 33H36V49H31.4V39L28 40.9V36.7Z" fill="#1C1917"/>
        </svg>
        <span class="app-logo-text">1time<span>io</span></span>
    </a>
    {lang !== 'en' && alternates ? (
    <nav class="app-nav">
        <a href={alternates.en} hreflang="en" lang="en">English</a>
        <a href="/developers/" hreflang="en">API</a>
        <a
            class="app-nav-icon"
            href="https://github.com/shingrus/1time"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={navText[lang].githubLabel}
        >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
        </a>
    </nav>
    ) : (
    <nav class="app-nav">
        <a href="/password-generator/">Password Generator</a>
        {!selfHosted && <a href="/blog/">Blog</a>}
        {!selfHosted && <a href="/developers/">API</a>}
        <a
            class="app-nav-icon"
            href="https://github.com/shingrus/1time"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View on GitHub"
        >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
        </a>
    </nav>
    )}
</header>
