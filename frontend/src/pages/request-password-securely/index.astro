---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineCss from '../../components/InlineCss.astro';
import ShareOptions from '../../components/ShareOptions.astro';
import EncryptionNote from '../../components/EncryptionNote.astro';
import LinkReadyTemplate from '../../components/LinkReadyTemplate.astro';
import {absoluteUrl, siteHost} from '../../lib/siteConfig.js';

const title = `Request a Password Securely — No Signup | ${siteHost}`;
const description = 'Request a password securely: send a one-time link, they type it in, and only you can open it, once. Encrypted in the browser. Free, no signup.';
const requestMessage = 'Hi, could you send me the login through this secure link? Type it in and press Encrypt and send. It is encrypted in your browser, only I can open it, and it is deleted after I read it.';

const faqItems = [
    {question: 'Does the other person need an account?', answer: 'No. They open the link in any browser, type the password and press Encrypt and send. You do not need an account either.'},
    {question: 'Can 1time.io read the answer?', answer: 'No. The answer is encrypted in their browser with AES-256-GCM. The key is only in the request link and in your browser, never on our server, which stores ciphertext and hashes only.'},
    {question: 'What if someone else gets the request link?', answer: 'Anyone who has the link can answer it once, but nobody can read anything through it. Send the link only to the person you are asking. If the answer you get is not what you expected, create a new request.'},
    {question: 'How long does a request last?', answer: 'You choose from 1 hour to 7 days. After that the link stops working. An answer waits for you until you open it, at most until the request time runs out, and is deleted once you read it.'},
    {question: 'Where do I see the answer?', answer: 'On the request page while it is open, and in My Secrets in the same browser. The page checks every 30 seconds, updates the tab title when the answer arrives, and can show a browser notification.'},
    {question: 'What if I clear my browser or switch devices?', answer: 'The key that opens the answer lives only in the browser where you created the request. Open the answer there. If you clear the site data first, the answer can no longer be opened.'},
    {question: 'Can I request a file?', answer: 'Not yet. Requests are for text: passwords, API keys, recovery codes or notes. To send a file yourself, use one-time file sharing.'},
];

const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'Request a Password Securely',
        url: absoluteUrl('/request-password-securely/'),
        description: 'Request a password or API key through a one-time link. The answer is encrypted in the sender\'s browser and only the requester can open it, once. Free, no signup.',
        applicationCategory: 'SecurityApplication',
        operatingSystem: 'Any',
        offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
        featureList: 'One-time request links, End-to-end encryption, No account for either side, Auto-expiry, Zero-knowledge architecture',
        dateModified: '2026-11-22',
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            {'@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/')},
            {'@type': 'ListItem', position: 2, name: 'Request a Password Securely', item: absoluteUrl('/request-password-securely/')},
        ],
    },
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: {'@type': 'Answer', text: item.answer},
        })),
    },
];
---
<BaseLayout
    title={title}
    description={description}
    canonical="/request-password-securely/"
>
    <InlineCss slot="head" name="home" />
    <InlineCss slot="head" name="article" />
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline></script>

    <div class="share-flow-page">
        <nav class="share-mode-nav" aria-label="Choose sharing mode">
            <a href="/" class="share-mode-link">Text secret</a>
            <a href="/secure-file-sharing/" class="share-mode-link">One-time file</a>
            <a href="/request-password-securely/" class="share-mode-link share-mode-link-active">Request<span>&nbsp;a secret</span></a>
        </nav>

        <form id="request-form" autocomplete="off" data-message={requestMessage}>
            <div class="share-card">
                <p class="share-title">Ask someone to send you a password</p>
                <div class="article-body">
                    <ol>
                        <li>Get a link and send it to them.</li>
                        <li>They type the password into it.</li>
                        <li>It appears here, and only you can open it, once.</li>
                    </ol>
                </div>

                <ShareOptions kind="request">
                    <button slot="submit" class="btn btn-primary btn-lg" type="submit" disabled data-create>Get the link</button>
                </ShareOptions>

                <p class="form-help form-help-error share-form-error" data-error role="alert" hidden></p>
                <EncryptionNote />
            </div>
        </form>

        <LinkReadyTemplate />

        <section class="seo-section">
            <h1>Request a Password Securely</h1>
            <p>
                A request link lets you collect a password, API key or login credentials from a client or colleague
                without them ever landing in email or chat. You create the link, they type the secret into it,
                and it is encrypted in their browser so only you can open it, once. No signup: neither of you
                needs an account.
            </p>

            <h2>How to request a password securely</h2>
            <div class="article-body">
            <ol>
                <li>Create a request link above. Add a note so you remember who it is for.</li>
                <li>Send the link by email, Slack, Teams or text, with a short message like the one below.</li>
                <li>They open it, type the password and press Encrypt and send. It is encrypted in their browser.</li>
                <li>You get the answer on this page or in <a href="/my-secrets/">My Secrets</a>, open it once, and it is deleted.</li>
            </ol>
            </div>

            <h2>Who uses request links</h2>
            <div class="article-body">
            <ul>
                <li><strong>Web agencies</strong> collecting CMS, hosting and DNS logins from a new client.</li>
                <li><strong>IT teams and MSPs</strong> getting Wi-Fi, VPN or service account passwords during onboarding.</li>
                <li><strong>Freelancers and developers</strong> who need an API key or database password from a client.</li>
                <li><strong>Accountants and assistants</strong> receiving portal logins they need to do the work.</li>
            </ul>
            </div>

            <h2>Why not just ask them to email it?</h2>
            <p>
                A password sent by email or chat stays in both inboxes, on mail servers, in backups and in
                searchable chat history for years. Anyone who later gets into either account can find it
                (<a href="/blog/is-slack-safe-for-passwords/">is Slack safe for passwords?</a>). A request
                link carries no secret itself, and the answer is deleted as soon as you open it.
            </p>

            <h2>Ways to get a password from someone, compared</h2>
            <table class="comparison-table">
                <thead>
                    <tr><th>Method</th><th>Account needed</th><th>Where copies remain</th></tr>
                </thead>
                <tbody>
                    <tr><td><strong>Email or chat</strong></td><td>No</td><td>Both inboxes or chats, their servers, backups and search</td></tr>
                    <tr><td><strong>Password manager sharing</strong></td><td>Yes, usually the same manager on both sides</td><td>The shared vault</td></tr>
                    <tr><td><strong>Request tools with a sign-up</strong></td><td>Yes, for you</td><td>The provider's server until you retrieve it</td></tr>
                    <tr><td><strong>1time.io request link</strong></td><td>No, for either of you</td><td>Only ciphertext until you open it, then nothing</td></tr>
                </tbody>
            </table>

            <h2>How to ask a client for login credentials</h2>
            <p>Send the request link with a short message like this:</p>
            <div class="feature-card">
                <p>{requestMessage} [paste your request link here]</p>
            </div>

            <h2>Frequently asked questions</h2>
            {faqItems.map((item) => (
                <div class="feature-card" style="margin-bottom:12px">
                    <div class="feature-card-header"><h3>{item.question}</h3></div>
                    <p>{item.answer}</p>
                </div>
            ))}

            <h2>More ways to share securely</h2>
            <nav class="seo-nav">
                <a href="/share-password-securely/">Share a password securely</a>
                <a href="/secure-file-sharing/">One-time file sharing</a>
                <a href="/my-secrets/">My Secrets</a>
                <a href="/blog/how-to-share-api-keys/">How to share API keys</a>
                <a href="/blog/is-slack-safe-for-passwords/">Is Slack safe for passwords?</a>
            </nav>
            <p>Updated <time datetime="2026-11-22">Nov 22, 2026</time></p>
        </section>
    </div>

    <script>
        import '../../islands/request-secret.ts';
    </script>
</BaseLayout>
