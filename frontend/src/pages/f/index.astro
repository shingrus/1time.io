---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineCss from '../../components/InlineCss.astro';
import {siteHost} from '../../lib/siteConfig.js';

const title = `Download Encrypted File — ${siteHost}`;
const description = 'Open an encrypted one-time file link shared through 1time.io. The file is decrypted in your browser and destroyed after download.';
---
<BaseLayout
    title={title}
    description={description}
    canonical="/f/"
    ogImage="/1time-og-main.png"
    ogImageAlt={`${siteHost} encrypted one-time file link`}
    robots="noindex, nofollow"
>
    <InlineCss slot="head" name="view" />

    <div>
        <form id="view-file-form" autocomplete="off">
            <div class="alert alert-warning" data-wrong-key hidden>
                Wrong passphrase. Please try again.
            </div>

            <div class="form-field" data-state="passphrase" hidden>
                <label class="form-label" for="secretKey">Passphrase required</label>
                <input
                    autofocus
                    class="form-input"
                    id="secretKey"
                    autocomplete="off"
                    autocapitalize="none"
                    placeholder="Enter the passphrase from the sender"
                    spellcheck="false"
                    type="text"
                />
            </div>

            <div data-state="pre-read">
                <div class="confirm-gate">
                    <div class="confirm-gate-icon" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            <circle cx="12" cy="16" r="1"/>
                        </svg>
                    </div>
                    <h2 class="confirm-gate-title">Someone sent you a file</h2>
                    <p class="confirm-gate-desc">
                        This is a <strong>one-time link</strong>. The number of downloads is limited, and the encrypted file is deleted after the final download.
                    </p>
                    <button class="btn btn-success btn-lg" type="submit" data-download>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        <span data-download-label>Download the file</span>
                    </button>
                    <div class="dl-progress" data-progress hidden aria-live="polite">
                        <div class="dl-progress-track">
                            <div class="dl-progress-fill" data-progress-fill></div>
                        </div>
                        <span class="dl-progress-text" data-progress-text>Starting…</span>
                    </div>
                </div>
            </div>

            <div data-state="downloaded" hidden>
                <div class="confirm-gate">
                    <div class="confirm-gate-icon confirm-gate-icon-muted" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                    </div>
                    <h2 class="confirm-gate-title">File downloaded</h2>
                    <p class="confirm-gate-desc" data-download-state>Checking whether downloads remain…</p>
                </div>
                <div class="view-cta">
                    <div class="view-cta-box">
                        <p class="view-cta-heading">Reply securely with a one-time link.</p>
                        <a class="btn btn-primary btn-lg" href="/secure-file-sharing/?reply=4">Reply with an encrypted link →</a>
                    </div>
                </div>
            </div>

            <div data-state="no-message" hidden>
                <div class="confirm-gate">
                    <div class="confirm-gate-icon confirm-gate-icon-muted" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            <circle cx="12" cy="16" r="1"/>
                        </svg>
                    </div>
                    <h2 class="confirm-gate-title">This file is gone</h2>
                    <a class="btn btn-primary btn-lg" href="/secure-file-sharing/">Send your own file</a>
                </div>
            </div>

            {/* See the matching block in v/index.astro: the fragment cannot name a
                file, so the link is mangled rather than consumed. */}
            <div data-state="broken-link" hidden>
                <div class="confirm-gate">
                    <div class="confirm-gate-icon confirm-gate-icon-muted" aria-hidden="true">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 17H7A5 5 0 0 1 7 7h2"/>
                            <path d="M15 7h2a5 5 0 0 1 4 8"/>
                            <line x1="8" y1="12" x2="12" y2="12"/>
                            <line x1="2" y1="2" x2="22" y2="22"/>
                        </svg>
                    </div>
                    <h2 class="confirm-gate-title">This link is incomplete</h2>
                    <p class="confirm-gate-desc">
                        The part after <strong>#</strong> carries the decryption key, and chat
                        apps sometimes cut it off. Go back to the message and copy the whole link.
                    </p>
                    <a class="btn btn-primary btn-lg" href="/secure-file-sharing/?reply=5">Send your own file</a>
                </div>
            </div>

            <div data-state="error" hidden>
                <div class="destroyed-notice">
                    <p><strong>Download interrupted.</strong> Your connection dropped before the file finished arriving.</p>
                    <p class="dl-note">Because this is a one-time link, it may already be used up. Try once more — and if it still doesn't load, ask the sender for a new link.</p>
                    <button class="btn btn-primary" type="submit" data-download-retry>Try again</button>
                </div>
            </div>
        </form>

        <div class="view-powered-by">
            <a href="https://1time.io" target="_blank" rel="noopener noreferrer">
                Powered by <strong>1time.io</strong>
            </a>
            <span class="view-powered-by-tagline">Free, open-source, zero-knowledge encryption. Your files are encrypted in the browser — the server never sees them.</span>
        </div>
    </div>

    <script>
        import '../../islands/view-file.ts';
    </script>
</BaseLayout>
