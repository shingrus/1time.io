    "typescript": "^5.6.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.17",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
