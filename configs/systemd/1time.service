[Unit]
Description=1time backend service
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=1time
Group=1time
WorkingDirectory=/opt/1time
# All configuration lives in the env file, not here: this unit is rewritten on
# every deploy, and a secret written into it would be cleared by any run that
# did not happen to pass it. That file is 0640, owned by root and readable by
# the service group set above, so it is also not world-readable the way this
# unit is.
#
# Written by scripts/update_vm.sh --init; edit it directly to change anything.
# The leading '-' lets the service start when it is missing, which is how a
# deployment with no Web Push keys simply runs without notifications.
EnvironmentFile=-/etc/1time/env
ExecStart=/opt/1time/bin/1time-api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
